// This is your Prisma schema file for PostgreSQL (Neon)
// Black Bear WebApp - Gestun Management System
// Uses Decimal for monetary values (exact precision)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== USER & AUTH ====================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  password      String
  role          String    @default("partner") // "owner" or "partner"
  avatar        String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  // Relations
  sessions      Session[]
  partner       Partner?
  
  @@map("users")
}

model Session {
  id            String    @id @default(cuid())
  userId        String
  expiresAt     DateTime
  createdAt     DateTime  @default(now())
  
  // Relations
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@map("sessions")
}

// ==================== PARTNER ====================

model Partner {
  id                String    @id @default(cuid())
  userId            String    @unique
  name              String
  email             String    @unique
  phone             String
  bankName          String
  bankAccount       String
  bankHolder        String
  city              String
  commission        Decimal   @default(30) // percentage
  target            Decimal   @default(5000000) // monthly target
  tier              String    @default("Bronze") // Bronze, Silver, Gold, Platinum
  badge             String    @default("Newbie") // Newbie, Rising Star, Champion, Legend
  status            String    @default("active") // active, suspended
  totalProfit       Decimal   @default(0)
  totalVolume       Decimal   @default(0)
  totalTransactions Int       @default(0)
  notes             String?   // additional notes from owner
  joinedAt          DateTime  @default(now())
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  
  // Relations
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions      Transaction[]
  customers         Customer[]
  rankingHistory    MonthlyRankingHistory[]
  
  @@index([status])
  @@index([tier])
  @@map("partners")
}

model MonthlyRankingHistory {
  id              String    @id @default(cuid())
  partnerId       String
  month           String    // format: YYYY-MM
  profit          Decimal   @default(0)
  volume          Decimal   @default(0)
  transactions    Int       @default(0)
  rank            Int?
  badge           String?
  createdAt       DateTime  @default(now())
  
  // Relations
  partner         Partner   @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  
  @@unique([partnerId, month])
  @@map("monthly_ranking_history")
}

// ==================== CUSTOMER ====================

model Customer {
  id                String    @id @default(cuid())
  name              String
  phone             String
  bankName          String?
  bankAccount       String?
  bankHolder        String?
  city              String?
  label             String    @default("Regular") // VIP, Regular, New, Blacklist
  totalVolume       Decimal   @default(0)
  totalTransactions Int       @default(0)
  partnerId         String?   // nullable - can be added by partner
  addedBy           String    @default("owner") // owner, partner, public - who added this customer
  notes             String?   // additional notes
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  
  // Relations
  partner           Partner?  @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  transactions      Transaction[]
  
  @@index([phone])
  @@index([city])
  @@index([label])
  @@map("customers")
}

// ==================== TRANSACTION ====================

model Transaction {
  id                String    @id @default(cuid())
  orderId           String    @unique // public order ID
  customerId        String
  partnerId         String?
  
  nominal           Decimal   // nominal gestun
  paymentFee        Decimal   // calculated fee
  platformFee       Decimal   @default(0) // marketplace fee
  netMargin         Decimal   // paymentFee - platformFee
  partnerProfit     Decimal   @default(0)
  ownerProfit       Decimal   @default(0)
  totalReceived     Decimal   // nominal - paymentFee
  
  paymentTypeId     String
  methodTransaction String    @default("Online") // Online, COD
  marketplaceId     String?   // for platform fee deduction
  
  status            String    @default("pending") // pending, verification, process, success, failed
  notes             String?   // catatan dari owner
  transactionLink   String?   // link untuk transaksi dari owner
  
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  
  // Relations
  customer          Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  partner           Partner?  @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  paymentType       PaymentType @relation(fields: [paymentTypeId], references: [id])
  marketplace       Marketplace? @relation(fields: [marketplaceId], references: [id], onDelete: SetNull)
  
  @@index([customerId])
  @@index([partnerId])
  @@index([status])
  @@index([createdAt])
  @@map("transactions")
}

// ==================== PAYMENT & FEE MANAGEMENT ====================

model PaymentType {
  id                String    @id @default(cuid())
  name              String    @unique  // e.g., "Kartu Kredit", "Paylater"
  onlineFeePercent  Decimal   @default(0) // percentage
  onlineFeeFlat     Decimal   @default(0) // flat fee under threshold
  codFeePercent     Decimal   @default(0)
  codFeeFlat        Decimal   @default(0)
  threshold         Decimal   @default(1000000) // threshold for percentage vs flat
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  
  // Relations
  transactions      Transaction[]
  
  @@map("payment_types")
}

model Marketplace {
  id              String    @id @default(cuid())
  name            String    @unique  // e.g., "Tokopedia", "Shopee"
  feePercent      Decimal   @default(0) // deduction from margin (percentage)
  feeFlat         Decimal   @default(0) // flat fee deduction
  description     String?   // notes about the marketplace
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  // Relations
  transactions    Transaction[]
  
  @@map("marketplaces")
}

// ==================== BROADCAST & ANNOUNCEMENT ====================

model Announcement {
  id              String    @id @default(cuid())
  title           String
  description     String
  type            String    @default("announcement") // promo, broadcast, announcement
  link            String?   // for promo: GDrive/Canva link
  isActive        Boolean   @default(true)
  startDate       DateTime?
  expireDate      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  @@index([type])
  @@index([isActive])
  @@map("announcements")
}

model Promo {
  id              String    @id @default(cuid())
  title           String
  description     String?
  link            String    // Canva/GDrive link
  isActive        Boolean   @default(true)
  startDate       DateTime?
  expireDate      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  @@map("promos")
}

// ==================== NOTIFICATIONS ====================

model Notification {
  id              String    @id @default(cuid())
  type            String    // "new_partner", "new_order", "transaction_update", "broadcast"
  title           String
  message         String
  data            String?   // JSON string for additional data
  isRead          Boolean   @default(false)
  
  // For targeting specific users (null = all owners)
  targetType      String    @default("owner") // owner, partner, all
  targetUserId    String?   // specific user ID if needed
  
  // Reference to related entities
  partnerId       String?
  transactionId   String?
  
  createdAt       DateTime  @default(now())
  readAt          DateTime?
  
  @@index([type])
  @@index([isRead])
  @@index([targetType])
  @@index([createdAt])
  @@map("notifications")
}

// ==================== SITE CONFIGURATION ====================

model SiteConfig {
  id              String    @id @default(cuid())
  key             String    @unique
  value           String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  @@map("site_configs")
}

// ==================== OWNER PROFILE ====================

model OwnerProfile {
  id              String    @id @default(cuid())
  name            String
  email           String
  avatar          String?
  websiteTitle    String    @default("Black Bear")
  logoUrl         String?
  faviconUrl      String?
  metaTitle       String?
  metaDescription String?
  footerEmail     String?
  footerWhatsapp  String?
  footerInstagram String?
  footerFacebook  String?
  footerTiktok    String?
  footerYoutube   String?
  footerThreads   String?
  maintenanceMode Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  // Relations
  notificationSettings NotificationSettings?
  
  @@map("owner_profiles")
}

// ==================== NOTIFICATION SETTINGS ====================

model NotificationSettings {
  id                    String    @id @default(cuid())
  ownerProfileId        String    @unique
  
  // Telegram Configuration
  telegramBotToken      String?
  telegramChatId        String?
  telegramEnabled       Boolean   @default(false)
  
  // Notification Preferences
  notifyNewTransaction  Boolean   @default(true)
  notifyTransactionStatus Boolean  @default(true)
  notifyNewPartner      Boolean   @default(true)
  notifyNewCustomer     Boolean   @default(false)
  notifyDailyReport     Boolean   @default(false)
  
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  
  // Relations
  ownerProfile          OwnerProfile @relation(fields: [ownerProfileId], references: [id], onDelete: Cascade)
  
  @@map("notification_settings")
}

// ==================== SEO CONTENT MANAGEMENT ====================

model BlogPost {
  id              String    @id @default(cuid())
  title           String
  slug            String    @unique
  content         String    // Markdown or HTML content
  excerpt         String?   // Short description for listing
  featuredImage   String?   // URL to featured image
  metaTitle       String?   // SEO title
  metaDescription String?   // SEO description
  keywords        String?   // Comma-separated keywords
  category        String    @default("artikel") // artikel, tips, tutorial, berita
  tags            String?   // Comma-separated tags
  author          String?   // Author name
  viewCount       Int       @default(0)
  isPublished     Boolean   @default(false)
  publishedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  @@index([slug])
  @@index([category])
  @@index([isPublished])
  @@index([publishedAt])
  @@map("blog_posts")
}

model FAQ {
  id              String    @id @default(cuid())
  question        String
  answer          String    // Markdown or HTML content
  category        String    @default("umum") // umum, layanan, pembayaran, mitra
  order           Int       @default(0) // Display order
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  @@index([category])
  @@index([order])
  @@map("faqs")
}

model Location {
  id              String    @id @default(cuid())
  name            String    // e.g., "Jakarta", "Bandung"
  slug            String    @unique // e.g., "jakarta", "bandung"
  description     String?   // Custom description for SEO
  content         String?   // Full page content (Markdown/HTML)
  featuredImage   String?   // URL to location image
  metaTitle       String?   // SEO title
  metaDescription String?   // SEO description
  keywords        String?   // Comma-separated keywords
  latitude        Float?    // GPS latitude for map
  longitude       Float?    // GPS longitude for map
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  @@index([slug])
  @@index([isActive])
  @@map("locations")
}
